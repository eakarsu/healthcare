# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/healthcare_practice_ai"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# OAuth Providers (for social login)
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Azure AD: https://portal.azure.com → App registrations
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
# Your Directory (tenant) ID from Azure Portal App Overview
AZURE_AD_TENANT_ID=""

# Encryption key for PHI (32 bytes, base64 encoded)
ENCRYPTION_KEY="your-32-byte-key-base64-encoded-here"

# Comma-separated HTTPS hostnames approved for outbound FHIR connections.
FHIR_ALLOWED_HOSTS="sandbox.fhir.example"

# OpenAI (for AI features)
OPENAI_API_KEY="sk-..."

# Deepgram (for speech-to-text) - Optional
DEEPGRAM_API_KEY=""

# Stripe (for patient payments)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret from https://dashboard.stripe.com/webhooks
# For local testing: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# Twilio (for SMS/Voice) - Optional
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1..."

# Email (SMTP) - Optional
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_DELIVERY_WEBHOOK_URL="https://mail.example/v1/send"
EMAIL_DELIVERY_HOST="mail.example"
EMAIL_DELIVERY_TOKEN=""

# Clearinghouse (for claims) - Optional
CLEARINGHOUSE_API_URL="https://api.clearinghouse.com"
CLEARINGHOUSE_API_KEY=""

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Local-only demo autofill; keep real values in the ignored .env file.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
