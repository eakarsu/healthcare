model CodingAuditRule {
  id              String    @id @default(cuid())
  name            String
  description     String?

  // Rule definition
  ruleType        String    // BUNDLING, MEDICAL_NECESSITY, MODIFIER, FREQUENCY
  conditions      Json      // Rule conditions
  action          String    // WARN, BLOCK, SUGGEST
  message         String

  // Applicability
  cptCodes        String[]  // Applicable CPT codes
  icdCodes        String[]  // Applicable ICD codes

  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============ DOCUMENT STORAGE (ENCRYPTED) ============

model EncryptedDocument {
  id              String    @id @default(cuid())

  // File metadata
  originalName    String
  encryptedPath   String?   // Local filesystem path (optional)
  encryptionKeyId String    // Reference to key used
  fileSize        Int
  mimeType        String
  checksum        String    // SHA-256 hash for integrity
  fileContent     Bytes?    // Store file content directly in DB

  // Classification
  category        String    // CLINICAL, BILLING, ADMINISTRATIVE, FAX
  documentType    String    // Specific type within category

  // Associations
  patientId       String?
  encounterId     String?
  claimId         String?
  faxMessageId    String?

  // Access control
  accessLevel     String    @default("PROVIDER") // PROVIDER, STAFF, BILLING, ADMIN

  // Lifecycle
  retentionDate   DateTime? // HIPAA: 6 years minimum
  archivedAt      DateTime?
  deletedAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String

  patient         Patient?  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([category])
  @@index([createdAt])
}

// ============ LAB ORDER TRACKING ============

