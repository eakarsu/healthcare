  name            String
  type            String    // EHR, LAB, IMAGING, HIE
  status          String    @default("active")

  // Connection details
  baseUrl         String
  clientId        String?
  clientSecret    String?   // Encrypted
  accessToken     String?   // Encrypted
  tokenExpiry     DateTime?

  // Supported resources
  resources       String[]  // Patient, Observation, DiagnosticReport, etc.

  // Sync settings
  autoSync        Boolean   @default(false)
  syncInterval    Int?      // Minutes
  lastSyncAt      DateTime?

