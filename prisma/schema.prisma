enum PriorAuthStatus {
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  APPEALED
  EXPIRED
  CANCELLED
}

model PayerAuthRules {
