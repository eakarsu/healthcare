  modality        String
  description     String?
  bodyPart        String?
  instanceCount   Int       @default(0)

  study           ImagingStudy @relation(fields: [studyId], references: [id])
  studyId         String

  instances       ImagingInstance[]
}

model ImagingInstance {
  id              String    @id @default(cuid())
  sopInstanceUid  String    @unique
  instanceNumber  Int

  // Image data
  rows            Int?
  columns         Int?
  bitsAllocated   Int?
  photometricInterpretation String?

  // File info
