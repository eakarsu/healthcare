  updatedAt       DateTime  @updatedAt
}

// ============ E-PRESCRIBING ============

model Prescription {
  id              String    @id @default(cuid())
  rxNumber        String    @unique
  status          PrescriptionStatus @default(DRAFT)

  // Medication details
  drugName        String
  drugCode        String?   // NDC or RxNorm
  strength        String?
  form            String?   // Tablet, Capsule, Solution, etc.

  // Sig (directions)
  dosage          String
  frequency       String
  route           String    @default("Oral")
  duration        String?
  quantity        Int
  quantityUnit    String    @default("tablets")
  refills         Int       @default(0)

  // DAW (Dispense As Written)
  dispenseAsWritten Boolean @default(false)

  // Controlled substance
  isControlled    Boolean   @default(false)
  scheduleClass   String?   // II, III, IV, V
  deaNumber       String?   // Provider DEA number used

  // EPCS (Electronic Prescribing for Controlled Substances)
  epcsEnabled     Boolean   @default(false)
  epcsSigned      Boolean   @default(false)
  epcsSignedAt    DateTime?
  epcsSignature   String?   // Encrypted

  // Pharmacy
  pharmacyId      String?
  pharmacyNpi     String?
  pharmacyName    String?
  pharmacyAddress String?
  pharmacyPhone   String?
  pharmacyFax     String?

  // Transmission
  transmissionMethod String? // Electronic, Fax, Print
  transmittedAt   DateTime?
  transmissionRef String?   // Surescripts reference
  transmissionStatus String?

  // Clinical
  indication      String?   // Diagnosis/reason
  notes           String?

  writtenDate     DateTime  @default(now())
  effectiveDate   DateTime?
  expirationDate  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient         Patient   @relation(fields: [patientId], references: [id])
  patientId       String
  provider        Provider  @relation(fields: [providerId], references: [id])
  providerId      String
  encounter       Encounter? @relation(fields: [encounterId], references: [id])
  encounterId     String?

  renewals        PrescriptionRenewal[]
  fills           PrescriptionFill[]
  drfirstTransactions DrFirstTransaction[]
}

enum PrescriptionStatus {
  DRAFT
  PENDING_SIGNATURE
  READY_TO_SEND
  SENT
  RECEIVED
  FILLED
  PARTIAL_FILL
  CANCELLED
  EXPIRED
  DENIED
}

model PrescriptionRenewal {
  id              String    @id @default(cuid())
  status          String    @default("PENDING")
  requestDate     DateTime  @default(now())
  requestSource   String?   // Pharmacy, Patient

  // Approval
  approvedBy      String?
  approvedAt      DateTime?
  denialReason    String?

  // New prescription created
  newRxId         String?

  prescription    Prescription @relation(fields: [prescriptionId], references: [id])
  prescriptionId  String
}

model PrescriptionFill {
  id              String    @id @default(cuid())
  fillNumber      Int       // 0 = original, 1+ = refills
  fillDate        DateTime
  quantityFilled  Int
  daysSupply      Int?
  pharmacyNpi     String?

  prescription    Prescription @relation(fields: [prescriptionId], references: [id])
  prescriptionId  String
}

model Pharmacy {
  id              String    @id @default(cuid())
  npi             String    @unique
  name            String
  ncpdpId         String?   // NCPDP ID for e-prescribing

  address         String
  city            String
  state           String
  zip             String
  phone           String
  fax             String?

  // Capabilities
  acceptsEpcs     Boolean   @default(false)
  acceptsNewRx    Boolean   @default(true)
  acceptsRefill   Boolean   @default(true)
  accepts24Hour   Boolean   @default(false)

  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DrugDatabase {
  id              String    @id @default(cuid())
  ndcCode         String    @unique
  rxNormCode      String?

  brandName       String
  genericName     String
  strength        String?
  form            String?
  route           String?
  manufacturer    String?

  // Classification
  therapeuticClass String?
  pharmacologicClass String?

  // Controlled substance
  isControlled    Boolean   @default(false)
  scheduleClass   String?

  // Interactions
  interactions    Json?     // Drug interaction data

  // Formulary
  isFormulary     Boolean   @default(true)

  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============ MEDICAL IMAGING ============

model ImagingStudy {
  id              String    @id @default(cuid())
  accessionNumber String    @unique
  status          ImagingStudyStatus @default(SCHEDULED)

  // Study info
  modality        String    // CT, MR, XR, US, etc.
  bodyPart        String?
  studyDescription String?

