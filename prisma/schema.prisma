// ============ PRIOR AUTHORIZATION ============

model PriorAuthorization {
  id              String    @id @default(cuid())
  authNumber      String?   // Authorization number from payer
  status          PriorAuthStatus @default(PENDING)
  urgency         String    @default("STANDARD") // STANDARD, URGENT

  // Request details
