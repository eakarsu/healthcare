  orderNumber     String          @unique
  status          LabOrderStatus  @default(PENDING)

  // Order details
  orderedAt       DateTime        @default(now())
  orderedBy       String          // Provider ID

  // Lab info (internal tracking)
  labName         String?         // Reference lab name
  labPhone        String?
  labFax          String?

  // Specimen
  specimenType    String?         // Blood, Urine, Tissue, etc.
  specimenCollectedAt DateTime?
  specimenSentAt  DateTime?

  // Tests ordered
  testCodes       String[]        // CPT codes
  testDescriptions String[]

  // Urgency
  priority        String          @default("ROUTINE") // STAT, ROUTINE, ASAP

  // Results tracking
  expectedResultsAt DateTime?
  resultsReceivedAt DateTime?
  resultsDocumentId String?       // Link to EncryptedDocument

  // Clinical
  icdCodes        String[]
  clinicalNotes   String?

  // Follow-up
  reviewedAt      DateTime?
  reviewedBy      String?
  followUpRequired Boolean        @default(false)
  followUpNotes   String?
  patientNotified Boolean         @default(false)
  patientNotifiedAt DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  patientId       String
  encounterId     String?

  patient         Patient         @relation(fields: [patientId], references: [id])
  encounter       Encounter?      @relation(fields: [encounterId], references: [id])
  statusHistory   LabOrderStatusHistory[]

  @@index([patientId])
  @@index([status])
  @@index([orderedAt])
}

enum LabOrderStatus {
  PENDING
  SPECIMEN_COLLECTED
  SENT_TO_LAB
  IN_PROGRESS
  RESULTS_RECEIVED
  REVIEWED
  COMPLETED
  CANCELLED
}

model LabOrderStatusHistory {
  id          String          @id @default(cuid())
  labOrderId  String
  status      LabOrderStatus
  changedAt   DateTime        @default(now())
  changedBy   String
  notes       String?

  labOrder    LabOrder        @relation(fields: [labOrderId], references: [id])

  @@index([labOrderId])
}

// ============ CLAIMS SUBMISSION (CLEARINGHOUSE) ============

model ClaimSubmission {
  id                String    @id @default(cuid())
  claimId           String
  submissionType    String    // ORIGINAL, CORRECTED, VOID
  transactionId     String?   // Change Healthcare transaction ID

  // EDI 837 data
  edi837Content     String?   @db.Text
  edi837FileName    String?

  // Response tracking
  submittedAt       DateTime?
  acknowledgedAt    DateTime?
  processedAt       DateTime?

  // Status from clearinghouse
  clearinghouseStatus String  @default("PENDING")
  responseCode      String?
  responseMessage   String?

  // ERA/835 data
  era835Content     String?   @db.Text
  era835ReceivedAt  DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  claim             Claim     @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@index([transactionId])
}

// ============ ELIGIBILITY VERIFICATION ============

model EligibilityCheck {
  id                  String    @id @default(cuid())
  patientInsuranceId  String
  transactionId       String?   // Change Healthcare transaction ID

  // Request data
  serviceDate         DateTime
  serviceTypeCodes    String[]  // 30=Health Benefit Plan Coverage, etc.

  // EDI 270/271 data
  edi270Content       String?   @db.Text
  edi271Content       String?   @db.Text

  // Parsed response
  eligibilityStatus   String    // ACTIVE, INACTIVE, UNKNOWN
  coverageDetails     Json?     // Parsed benefit information
  copayInfo           Json?
  deductibleInfo      Json?
  outOfPocketInfo     Json?

  // Caching
  checkedAt           DateTime  @default(now())
  expiresAt           DateTime  // Cache expiration

  createdAt           DateTime  @default(now())

  patientInsurance    PatientInsurance @relation(fields: [patientInsuranceId], references: [id])

  @@index([patientInsuranceId])
  @@index([checkedAt])
}

// ============ E-PRESCRIBING (DRFIRST) ============

model DrFirstTransaction {
  id                String    @id @default(cuid())
  prescriptionId    String
  transactionType   String    // NEWRX, REFILL_REQUEST, CANCEL, CHANGE
  transactionId     String?   // DrFirst transaction ID

  // Surescripts message
  ncpdpScriptVersion String?  // 10.6, 2017071, etc.
  messageContent    String?   @db.Text

  // Status tracking
  status            String    @default("PENDING")
  sentAt            DateTime?
  acknowledgedAt    DateTime?

  // Response
  responseCode      String?
  responseMessage   String?
  pharmacyResponse  Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  prescription      Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId])
  @@index([transactionId])
}

model ProviderEPCS {
  id                  String    @id @default(cuid())
  providerId          String    @unique

  // Identity proofing
  identityProofedAt   DateTime?
  identityProofMethod String?

  // DEA registration
  deaNumber           String?
  deaExpirationDate   DateTime?
  deaSchedules        String[]  // II, III, IV, V

  // Two-factor for EPCS
  epcsTokenSerial     String?
  epcsTokenActivatedAt DateTime?

  // Certification
  epcsActivatedAt     DateTime?
  epcsDeactivatedAt   DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  provider            Provider  @relation(fields: [providerId], references: [id])
}

// ============ FAX INTEGRATION (TWILIO) ============

model FaxMessage {
  id              String    @id @default(cuid())
  direction       String    // INBOUND, OUTBOUND
  status          String    @default("PENDING")

  // Twilio references
  twilioSid       String?   @unique
  twilioMediaUrl  String?

  // Sender/recipient
  fromNumber      String
  toNumber        String

  // Content
  numPages        Int?
  quality         String?
  documentPath    String?   // Encrypted local path

  // Association (optional)
  patientId       String?
  encounterId     String?
  prescriptionId  String?
  priorAuthId     String?

  // Processing
  processedAt     DateTime?
  processedBy     String?
  category        String?   // LAB_RESULT, REFERRAL, RX_REQUEST, etc.

  sentAt          DateTime?
  receivedAt      DateTime?
  failedAt        DateTime?
  errorMessage    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  patient         Patient?  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

// ============ PATIENT SELF CHECK-IN KIOSK ============

model KioskSession {
  id                  String    @id @default(cuid())
  sessionToken        String    @unique
  status              String    @default("ACTIVE")

  // Identification
  appointmentId       String?   @unique
  patientId           String?

  // Check-in flow
  verificationMethod  String?   // DOB, LAST4SSN, PHONE
  verifiedAt          DateTime?

  // Forms completed
  demographicsUpdated Boolean   @default(false)
  insuranceVerified   Boolean   @default(false)
  consentsSigned      Boolean   @default(false)
  formsCompleted      String[]  // Form IDs

  // Payment
  copayCollected      Decimal?  @db.Decimal(10, 2)
  paymentMethod       String?
  paymentTransactionId String?

  // Timing
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  expiredAt           DateTime?

  // Device info
  deviceId            String?
  locationId          String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  appointment         Appointment? @relation(fields: [appointmentId], references: [id])
  patient             Patient?    @relation(fields: [patientId], references: [id])

  @@index([appointmentId])
  @@index([patientId])
  @@index([sessionToken])
}

model KioskDevice {
  id                    String    @id @default(cuid())
  deviceName            String
  deviceToken           String    @unique
  locationId            String

  // Configuration
  enablePayments        Boolean   @default(true)
  enableInsuranceCapture Boolean  @default(true)
  enableFormSigning     Boolean   @default(true)

  // Status
  lastHeartbeat         DateTime?
  isOnline              Boolean   @default(false)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  location              Location  @relation(fields: [locationId], references: [id])

  @@index([locationId])
}

// ============ SUPERBILL / WALKOUT STATEMENT ============

model Superbill {
  id                String    @id @default(cuid())
  superbillNumber   String    @unique

  // Visit info
  encounterId       String    @unique
  patientId         String
  providerId        String
  serviceDate       DateTime

  // Diagnoses
  diagnoses         Json      // Array of ICD codes with descriptions

  // Procedures/services
  procedures        Json      // Array of CPT codes with fees

  // Totals
  totalCharges      Decimal   @db.Decimal(10, 2)
  insuranceEstimate Decimal?  @db.Decimal(10, 2)
  patientEstimate   Decimal?  @db.Decimal(10, 2)
  amountPaid        Decimal   @db.Decimal(10, 2) @default(0)

  // Payment collected at checkout
  paymentCollected  Decimal?  @db.Decimal(10, 2)
  paymentMethod     String?
  paymentTransactionId String?

  // PDF generation
  pdfPath           String?   // Path to generated PDF
  pdfGeneratedAt    DateTime?

  // Delivery
  printedAt         DateTime?
  emailedAt         DateTime?
  emailedTo         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  encounter         Encounter @relation(fields: [encounterId], references: [id])
  patient           Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([serviceDate])
}

// ============ QUALITY MEASURES / MIPS ============

model QualityMeasure {
  id                      String    @id @default(cuid())
  measureId               String    @unique // CMS measure ID (e.g., "CMS134v8")
  measureTitle            String
  category                String    // QUALITY, PI, IA, COST
  domain                  String?   // E.g., "Effective Clinical Care"

  // Measure details
  description             String?   @db.Text
  numeratorDescription    String?   @db.Text
  denominatorDescription  String?   @db.Text
  exclusionCriteria       String?   @db.Text

  // Scoring
  highPriority            Boolean   @default(false)
  outcomeOrPatientExp     Boolean   @default(false)
  measurePoints           Int       @default(10)

  // Benchmark data
  benchmark3Star          Decimal?  @db.Decimal(5, 2)
  benchmark4Star          Decimal?  @db.Decimal(5, 2)
  benchmark5Star          Decimal?  @db.Decimal(5, 2)

  isActive                Boolean   @default(true)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  patientMeasures         PatientQualityMeasure[]
}

model PatientQualityMeasure {
  id                  String    @id @default(cuid())
  measureId           String
  patientId           String
  providerId          String

  // Performance period
  performanceYear     Int
  performanceStart    DateTime
  performanceEnd      DateTime

  // Status
  inDenominator       Boolean   @default(false)
  inNumerator         Boolean   @default(false)
  isExcluded          Boolean   @default(false)
  isException         Boolean   @default(false)

  // Data points
  measureDate         DateTime?
  measureValue        String?
  measureValueNumeric Decimal?  @db.Decimal(10, 2)

  // Documentation
  encounterId         String?
  documentationNotes  String?

  // Automation
  autoCalculated      Boolean   @default(false)
  lastCalculatedAt    DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  measure             QualityMeasure @relation(fields: [measureId], references: [id])
  patient             Patient   @relation(fields: [patientId], references: [id])

  @@unique([measureId, patientId, performanceYear])
  @@index([patientId])
  @@index([providerId])
  @@index([performanceYear])
}

model MIPSSubmission {
  id                String    @id @default(cuid())
  submissionYear    Int
  submissionType    String    // INDIVIDUAL, GROUP

  // Submission data
  qualityScore      Decimal?  @db.Decimal(5, 2)
  piScore           Decimal?  @db.Decimal(5, 2)
  iaScore           Decimal?  @db.Decimal(5, 2)
  costScore         Decimal?  @db.Decimal(5, 2)
  finalScore        Decimal?  @db.Decimal(5, 2)

  // Status
  status            String    @default("DRAFT")
  submittedAt       DateTime?
  confirmedAt       DateTime?

  // CMS response
  cmsAcknowledged   Boolean   @default(false)
  cmsResponseDate   DateTime?
  cmsResponseData   Json?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([submissionYear, submissionType])
}

// ============ AI RESULT LOG ============
// Persists every AI call (input/output JSONB) for audit, analytics, and
// retraining. Indexed by feature + user + patient for HIPAA reporting.
model AIResult {
  id            String    @id @default(cuid())
  feature       String    // e.g. ambient-scribe, billing-coder, denial-predictor
  model         String    // e.g. anthropic/claude-3-5-sonnet-20241022
  userId        String?
  practiceId    String?
  patientId     String?
  input         Json      // Sanitised inputs sent to the model
  output        Json      // Parsed model output (or raw text)
  durationMs    Int?
  success       Boolean   @default(true)
  errorMessage  String?

  createdAt     DateTime  @default(now())

  @@index([feature])
  @@index([userId])
  @@index([practiceId])
  @@index([patientId])
  @@index([createdAt])
}
